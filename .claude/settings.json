{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm check*)",
      "Bash(pnpm fix:*)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm exec knip*)",
      "Bash(pnpm test*)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm db:generate*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm --filter * build*)",
      "Bash(node .claude/skills/run-gamedeck/*)",
      "Bash(curl -s* localhost:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git branch*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./deploy/.env)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.cjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.cjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
