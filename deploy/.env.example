# Домен, A-запись которого указывает на IP сервера. Telegram Mini App требует HTTPS.
# Нет своего домена — можно взять бесплатный вида 203-0-113-10.sslip.io (подставьте IP сервера через дефисы).
DOMAIN=gamedeck.example.com

# Пароль базы: длинный и случайный, например из `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Telegram Mini App (docs/telegram-guide.md).
# Токен от @BotFather: им сервер проверяет подпись initData. Сам сервер в api.telegram.org не ходит.
BOT_TOKEN=
# Ссылка на Mini App из /newapp: https://t.me/<бот>/<short name>. Из неё делаются приглашения в комнату.
TELEGRAM_APP_URL=

STARTING_COINS=500
LOG_LEVEL=info
