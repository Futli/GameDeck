# Домен, A-запись которого указывает на IP сервера. Telegram Mini App требует HTTPS.
# Нет своего домена — можно взять бесплатный вида 203-0-113-10.sslip.io (подставьте IP сервера через дефисы).
DOMAIN=gamedeck.example.com

# Если 80/443 уже занимает другой reverse proxy (Caddy, nginx) и HTTPS делает он,
# раскомментируйте: внутренний Caddy будет слушать только http на 80.
# Внешний прокси направьте на http://<IP сервера>:80.
# SITE_ADDRESS=:80

# Пароль базы: длинный и случайный, например из `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me

# Telegram Mini App (docs/telegram-guide.md).
# Токен от @BotFather: им сервер проверяет подпись initData.
BOT_TOKEN=
# Ссылка на Mini App из /newapp: https://t.me/<бот>/<short name>. Из неё делаются приглашения в комнату.
TELEGRAM_APP_URL=

# Бот с виджетом «Кубик удачи» (docs/widget-guide.md). 1 — сервер сам получает сообщения бота.
# Нужен доступ к api.telegram.org; из России — через прокси ниже.
TELEGRAM_BOT_POLLING=
# Виджет «Кубик удачи» в чате с ботом: 0 — не присылать (Telegram временно отключил виджеты),
# бот ведёт в Mini App, где виджет стоит на главной. Пусто или 1 — присылать.
TELEGRAM_CHAT_WIDGET=
# Прокси до Telegram (docs/deploy-guide.md, шаг 8). Обе строки включают контейнер xray из compose.yml.
# COMPOSE_PROFILES=proxy
# TELEGRAM_PROXY_URL=http://xray:8118

# Монеты нового игрока. Уже зарегистрированных не касается.
STARTING_COINS=0
LOG_LEVEL=info
