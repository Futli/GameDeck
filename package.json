{
  "name": "gamedeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamedeck/server --filter @gamedeck/client dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @gamedeck/server start",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:ts && pnpm check:unused && pnpm test",
    "check:ts": "pnpm -r run typecheck",
    "check:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "check:format": "prettier --check .",
    "fix:format": "prettier --write . --list-different",
    "check:unused": "knip",
    "test": "vitest run",
    "db:generate": "pnpm --filter @gamedeck/server db:generate",
    "db:studio": "pnpm --filter @gamedeck/server db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "knip": "^5.88.1",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4"
  }
}
