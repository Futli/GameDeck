{
  "name": "gamedeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamedeck/server --filter @gamedeck/client dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @gamedeck/server start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @gamedeck/server db:generate",
    "db:studio": "pnpm --filter @gamedeck/server db:studio"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
